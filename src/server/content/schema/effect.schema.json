{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dice-skirmish.local/schema/effect.schema.json",
  "title": "Effect",
  "description": "Catalogue effect node. New JSON should prefer AST (op). Legacy type members are compiled by AstCompiler. Both are valid.",
  "$ref": "#/$defs/effect",
  "$defs": {
    "effect": {
      "title": "Effect",
      "oneOf": [
        { "$ref": "#/$defs/astEffect" },
        { "$ref": "#/$defs/legacyEffect" }
      ]
    },
    "effectList": {
      "type": "array",
      "items": { "$ref": "#/$defs/effect" }
    },
    "negateCardTypes": {
      "description": "Which card links negate-card can hit. any = any card-sourced chain link (not attacks; forge never opens the chain).",
      "oneOf": [
        { "const": "any" },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "defs.schema.json#/$defs/cardType" }
        }
      ]
    },
    "astOp": {
      "type": "string",
      "enum": [
        "damage",
        "heal",
        "mark",
        "strip",
        "draw",
        "discard",
        "search",
        "mill",
        "forge",
        "reposition",
        "swap",
        "negate",
        "modify",
        "generate-symbol",
        "convert-symbols",
        "sequence",
        "branch",
        "prompt",
        "prevent-attack-reflect",
        "replace-synthetic-face",
        "retain-die",
        "replay-graveyard-tactic",
        "copy-pool-symbol",
        "look-top-deck",
        "peek-deck-optional-bottom",
        "dark-pact",
        "mind-control",
        "extermination",
        "reapply-die-modifiers",
        "copy-other-die-face",
        "optional-reroll-die",
        "remove-toxin-deal-damage",
        "lock-corrupted-face-resource",
        "spread-corruption-marker",
        "suppress-opposing-natural-inherent",
        "strip-corrupted-face-unusable-symbol",
        "arm-wildcard-from-synthetic-pool",
        "copy-appeared-synthetic-onroll",
        "optional-overcharge",
        "optional-bonus-basic-attack",
        "destroy-equipment",
        "destroy-ritual",
        "destroy-overload",
        "drain-life",
        "search-graveyard",
        "silence",
        "bounce",
        "desynthesize"
      ]
    },
    "astEffect": {
      "title": "AST EffectNode",
      "description": "Spec 018 opcode tree. Prefer mark / strip / modify / sequence / branch over minting a new type. mark requires token; branch requires when; modify requires stat.",
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": { "$ref": "#/$defs/astOp" },
        "amount": { "$ref": "defs.schema.json#/$defs/valueExpr" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" },
        "token": { "$ref": "defs.schema.json#/$defs/tokenKind" },
        "player": { "$ref": "defs.schema.json#/$defs/playerSide" },
        "optional": { "type": "boolean" },
        "then": { "$ref": "#/$defs/effectList" },
        "else": { "$ref": "#/$defs/effectList" },
        "when": { "$ref": "defs.schema.json#/$defs/conditionExpr" },
        "effects": { "$ref": "#/$defs/effectList" },
        "filter": {
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/cardType" }
        },
        "maxPlayCost": { "$ref": "defs.schema.json#/$defs/amount" },
        "symbol": { "$ref": "defs.schema.json#/$defs/symbolType" },
        "fromSymbol": { "$ref": "defs.schema.json#/$defs/symbolType" },
        "stat": { "$ref": "defs.schema.json#/$defs/modifyStat" },
        "duration": { "$ref": "defs.schema.json#/$defs/duration" },
        "cardTypes": { "$ref": "#/$defs/negateCardTypes" },
        "scope": { "type": "string", "enum": ["card", "ritual"] },
        "faces": { "$ref": "defs.schema.json#/$defs/positiveAmount" },
        "kind": { "$ref": "defs.schema.json#/$defs/forgeableFaceKind" },
        "attribute": { "$ref": "defs.schema.json#/$defs/attribute" },
        "forgeTarget": { "$ref": "defs.schema.json#/$defs/forgeTarget" },
        "with": { "$ref": "defs.schema.json#/$defs/targetSelector" },
        "sourceOnly": { "type": "boolean" },
        "oncePerTurn": { "type": "boolean" },
        "sameFaceAllyDamage": { "$ref": "defs.schema.json#/$defs/amount" },
        "searchZone": { "type": "string", "enum": ["deck", "graveyard"] },
        "hosts": {
          "oneOf": [
            { "$ref": "defs.schema.json#/$defs/silenceHosts" },
            { "$ref": "defs.schema.json#/$defs/bounceHosts" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "mark" } }, "required": ["op"] },
          "then": {
            "required": ["token"],
            "properties": { "token": { "$ref": "defs.schema.json#/$defs/tokenKind" } }
          }
        },
        {
          "if": { "properties": { "op": { "const": "branch" } }, "required": ["op"] },
          "then": {
            "required": ["when"],
            "properties": { "when": { "$ref": "defs.schema.json#/$defs/conditionExpr" } }
          }
        },
        {
          "if": { "properties": { "op": { "const": "modify" } }, "required": ["op"] },
          "then": {
            "required": ["stat"],
            "properties": { "stat": { "$ref": "defs.schema.json#/$defs/modifyStat" } }
          }
        },
        {
          "if": { "properties": { "op": { "const": "silence" } }, "required": ["op"] },
          "then": {
            "required": ["target", "hosts"],
            "properties": {
              "target": { "$ref": "defs.schema.json#/$defs/targetSelector" },
              "hosts": { "$ref": "defs.schema.json#/$defs/silenceHosts" }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "bounce" } }, "required": ["op"] },
          "then": {
            "required": ["target", "hosts"],
            "properties": {
              "target": { "$ref": "defs.schema.json#/$defs/targetSelector" },
              "hosts": { "$ref": "defs.schema.json#/$defs/bounceHosts" }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "desynthesize" } }, "required": ["op"] },
          "then": {
            "required": ["target"],
            "properties": {
              "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
            }
          }
        }
      ]
    },
    "legacyEffect": {
      "title": "Legacy EffectDefinition",
      "description": "type-discriminated union the engine interprets today. Prefer AST op nodes for newly edited cards.",
      "oneOf": [
        { "$ref": "#/$defs/damage" },
        { "$ref": "#/$defs/heal" },
        { "$ref": "#/$defs/grantShield" },
        { "$ref": "#/$defs/generateSymbol" },
        { "$ref": "#/$defs/drawCards" },
        { "$ref": "#/$defs/discardCards" },
        { "$ref": "#/$defs/searchDeck" },
        { "$ref": "#/$defs/searchGraveyard" },
        { "$ref": "#/$defs/destroyEquipment" },
        { "$ref": "#/$defs/applyToxin" },
        { "$ref": "#/$defs/removeShield" },
        { "$ref": "#/$defs/nextAttackBonus" },
        { "$ref": "#/$defs/grantNextAttackBonus" },
        { "$ref": "#/$defs/armAttackToxin" },
        { "$ref": "#/$defs/negateCard" },
        { "$ref": "#/$defs/negateRitual" },
        { "$ref": "#/$defs/drainLife" },
        { "$ref": "#/$defs/destroyRitual" },
        { "$ref": "#/$defs/silence" },
        { "$ref": "#/$defs/bounce" },
        { "$ref": "#/$defs/desynthesize" },
        { "$ref": "#/$defs/destroyOverload" },
        { "$ref": "#/$defs/grantAttackPrevent" },
        { "$ref": "#/$defs/preventAttackReflect" },
        { "$ref": "#/$defs/armPreventDraw" },
        { "$ref": "#/$defs/forgeFaces" },
        { "$ref": "#/$defs/replaceSyntheticFace" },
        { "$ref": "#/$defs/repositionCreature" },
        { "$ref": "#/$defs/swapPositions" },
        { "$ref": "#/$defs/conditional" },
        { "$ref": "#/$defs/chooseEffectMode" },
        { "$ref": "#/$defs/retainDie" },
        { "$ref": "#/$defs/convertSymbols" },
        { "$ref": "#/$defs/armIgnoreShield" },
        { "$ref": "#/$defs/armRequirementWildcard" },
        { "$ref": "#/$defs/armForgeDiscount" },
        { "$ref": "#/$defs/playCostDiscount" },
        { "$ref": "#/$defs/armRedirectDamage" },
        { "$ref": "#/$defs/armNextIncomingBonus" },
        { "$ref": "#/$defs/armBladeRain" },
        { "$ref": "#/$defs/replayGraveyardTactic" },
        { "$ref": "#/$defs/copyPoolSymbol" },
        { "$ref": "#/$defs/lookTopDeck" },
        { "$ref": "#/$defs/peekDeckOptionalBottom" },
        { "$ref": "#/$defs/darkPact" },
        { "$ref": "#/$defs/mindControl" },
        { "$ref": "#/$defs/extermination" },
        { "$ref": "#/$defs/reapplyDieModifiers" },
        { "$ref": "#/$defs/copyOtherDieFace" },
        { "$ref": "#/$defs/optionalRerollDie" },
        { "$ref": "#/$defs/addPestilenceCounter" },
        { "$ref": "#/$defs/armToxinReceiveCap" },
        { "$ref": "#/$defs/removeToxinDealDamage" },
        { "$ref": "#/$defs/addCorruptionMarker" },
        { "$ref": "#/$defs/lockCorruptedFaceResource" },
        { "$ref": "#/$defs/spreadCorruptionMarker" },
        { "$ref": "#/$defs/suppressOpposingNaturalInherent" },
        { "$ref": "#/$defs/stripCorruptedFaceUnusableSymbol" },
        { "$ref": "#/$defs/armWildcardFromSyntheticPool" },
        { "$ref": "#/$defs/copyAppearedSyntheticOnroll" },
        { "$ref": "#/$defs/optionalOvercharge" },
        { "$ref": "#/$defs/armResolveNextFaceEffectTwice" },
        { "$ref": "#/$defs/optionalBonusBasicAttack" },
        { "$ref": "#/$defs/grantExtraAttack" },
        { "$ref": "#/$defs/millCards" }
      ]
    },
    "damage": {
      "title": "damage",
      "description": "[Strike N] / deal damage to a creature.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "target"],
      "properties": {
        "type": { "const": "damage" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "heal": {
      "title": "heal",
      "description": "[Heal N] on a creature.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "target"],
      "properties": {
        "type": { "const": "heal" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "grantShield": {
      "title": "grant-shield",
      "description": "[Mark N Shield] on a creature.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "target"],
      "properties": {
        "type": { "const": "grant-shield" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "generateSymbol": {
      "title": "generate-symbol",
      "description": "[Generate N Attribute] into the controller's unabsorbed pool.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "symbol", "amount"],
      "properties": {
        "type": { "const": "generate-symbol" },
        "symbol": { "$ref": "defs.schema.json#/$defs/symbolType" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" }
      }
    },
    "drawCards": {
      "title": "draw-cards",
      "description": "[Draw N]. Default player is controller.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "const": "draw-cards" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "player": { "$ref": "defs.schema.json#/$defs/playerSide" }
      }
    },
    "discardCards": {
      "title": "discard-cards",
      "description": "[Discard N] from hand. optional allows fewer (including 0). then queues after a successful discard of at least one card.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "const": "discard-cards" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "optional": { "type": "boolean" },
        "then": { "$ref": "#/$defs/effectList" }
      }
    },
    "searchDeck": {
      "title": "search-deck",
      "description": "[Search N]: look through the controller's deck, choose up to amount cards whose main CardType is in filter, add them to hand, then shuffle.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "filter"],
      "properties": {
        "type": { "const": "search-deck" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "filter": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "defs.schema.json#/$defs/cardType" }
        }
      }
    },
    "searchGraveyard": {
      "title": "search-graveyard",
      "description": "[Recall N]: choose up to amount cards in the controller's graveyard and return them to hand. Optional maxPlayCost.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "const": "search-graveyard" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "maxPlayCost": { "$ref": "defs.schema.json#/$defs/amount" }
      }
    },
    "destroyEquipment": {
      "title": "destroy-equipment",
      "description": "Send one equipment to its owner's graveyard. Creature target: 0/1/2+ pieces (011). choose-opponent-equipment: field-wide pick.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "const": "destroy-equipment" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "applyToxin": {
      "title": "apply-toxin",
      "description": "[Mark N Toxin] on a creature.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "target"],
      "properties": {
        "type": { "const": "apply-toxin" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "removeShield": {
      "title": "remove-shield",
      "description": "[Strip N Shield] from a creature.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "target"],
      "properties": {
        "type": { "const": "remove-shield" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "nextAttackBonus": {
      "title": "next-attack-bonus",
      "description": "[Empower N] on the controller's next attack this turn (cleared at EOT).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "const": "next-attack-bonus" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" }
      }
    },
    "grantNextAttackBonus": {
      "title": "grant-next-attack-bonus",
      "description": "[Empower N] on a named creature's next attack.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "target"],
      "properties": {
        "type": { "const": "grant-next-attack-bonus" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "armAttackToxin": {
      "title": "arm-attack-toxin",
      "description": "Controller's attacks this turn apply this many Toxin markers to the attack target.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "const": "arm-attack-toxin" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" }
      }
    },
    "negateCard": {
      "title": "negate-card",
      "description": "[Negate]. Hits the top chain link when it is a card-sourced link. cardTypes any = any card; or a list of main types (e.g. [instant]).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cardTypes"],
      "properties": {
        "type": { "const": "negate-card" },
        "cardTypes": { "$ref": "#/$defs/negateCardTypes" }
      }
    },
    "negateRitual": {
      "title": "negate-ritual",
      "description": "[Negate Ritual]. Whiffs unless the top chain link is ritual-place or ritual-activate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "negate-ritual" } }
    },
    "drainLife": {
      "title": "drain-life",
      "description": "[Drain N]: deal up to amount damage to target, then heal with for the HP actually lost.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "target", "with"],
      "properties": {
        "type": { "const": "drain-life" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" },
        "with": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "destroyRitual": {
      "title": "destroy-ritual",
      "description": "Send one opposing field ritual to its owner's graveyard.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "const": "destroy-ritual" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "silence": {
      "title": "silence",
      "description": "[Silence] an opposing creature, field ritual, or die slot (hosts) until the start of your next turn. Spec 022.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "hosts"],
      "properties": {
        "type": { "const": "silence" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" },
        "hosts": { "$ref": "defs.schema.json#/$defs/silenceHosts" }
      }
    },
    "bounce": {
      "title": "bounce",
      "description": "[Bounce] an opposing ritual, equipment, or overload (hosts) to its owner's hand. Spec 023.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "hosts"],
      "properties": {
        "type": { "const": "bounce" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" },
        "hosts": { "$ref": "defs.schema.json#/$defs/bounceHosts" }
      }
    },
    "desynthesize": {
      "title": "desynthesize",
      "description": "[Desynthesize] a synthetic attribute face on any die to that attribute's natural. Spec 024. Not Reforge.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "const": "desynthesize" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "destroyOverload": {
      "title": "destroy-overload",
      "description": "Send one opposing attached overload to its owner's graveyard. choose-opponent-overload always prompts when ≥1 exists.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "const": "destroy-overload" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "grantAttackPrevent": {
      "title": "grant-attack-prevent",
      "description": "[Prevent N] — Luminar reaction-exclusive. Amount is incoming attack instances to cancel before Shields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "target"],
      "properties": {
        "type": { "const": "grant-attack-prevent" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" }
      }
    },
    "preventAttackReflect": {
      "title": "prevent-attack-reflect",
      "description": "Cancel damage on the waiting attack chain link and deal that amount to the attacker.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "prevent-attack-reflect" } }
    },
    "armPreventDraw": {
      "title": "arm-prevent-draw",
      "description": "Arm \"when you next prevent damage, draw N\".",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "const": "arm-prevent-draw" },
        "amount": { "$ref": "defs.schema.json#/$defs/amount" }
      }
    },
    "forgeFaces": {
      "title": "forge-faces",
      "description": "[Forge N] as an effect: the controller forges faces copies of one matching face card onto a single die. Same install rules as the PLAY forge region, without spending a tactic from hand.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "faces", "kind", "attribute", "target"],
      "properties": {
        "type": { "const": "forge-faces" },
        "faces": { "$ref": "defs.schema.json#/$defs/positiveAmount" },
        "kind": { "$ref": "defs.schema.json#/$defs/forgeableFaceKind" },
        "attribute": { "$ref": "defs.schema.json#/$defs/attribute" },
        "target": { "$ref": "defs.schema.json#/$defs/forgeTarget" }
      }
    },
    "replaceSyntheticFace": {
      "title": "replace-synthetic-face",
      "description": "[Reforge N Attribute] / [Cross forge N Y / Z]. Choose N replaceable slots on one owned die, then N synthetic destination faces from the pool. fromAttribute omitted = any showing face (Reforge). Set = Cross forge (slots must show Y). Always installs synthetic attribute. Not a forge — no forge-draw.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "faces", "attribute"],
      "properties": {
        "type": { "const": "replace-synthetic-face" },
        "faces": { "$ref": "defs.schema.json#/$defs/positiveAmount" },
        "attribute": { "$ref": "defs.schema.json#/$defs/attribute" },
        "fromAttribute": { "$ref": "defs.schema.json#/$defs/attribute" }
      }
    },
    "repositionCreature": {
      "title": "reposition-creature",
      "description": "Toggle an ally between frontline and back. Opposing targets whiff.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "const": "reposition-creature" },
        "target": { "$ref": "defs.schema.json#/$defs/targetSelector" },
        "optional": { "type": "boolean" }
      }
    },
    "swapPositions": {
      "title": "swap-positions",
      "description": "Swap the source creature with an ally with. Opposing targets whiff (push banned).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "with"],
      "properties": {
        "type": { "const": "swap-positions" },
        "with": { "$ref": "defs.schema.json#/$defs/targetSelector" },
        "optional": { "type": "boolean" }
      }
    },
    "conditional": {
      "title": "conditional",

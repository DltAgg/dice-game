{
  "$schema": "../schema/face.schema.json",
  "id": "face-synthetic-resonance-rune",
  "name": "Resonance Rune",
  "kind": "synthetic",
  "symbol": "arcane",
  "rulesText": "On roll: if there is another Arcane symbol in the Pool, [Gain 1 Energy].\nOn absorb, once per turn: [Resonance].",
  "onRoll": [
    {
      "type": "conditional",
      "when": {
        "type": "has-other-symbol",
        "symbol": "arcane"
      },
      "then": [
        {
          "type": "generate-symbol",
          "symbol": "arcane",
          "amount": 1
        }
      ]
    }
  ],
  "onAbsorb": [
    {
      "type": "arm-requirement-wildcard",
      "fromSymbol": "arcane"
    }
  ],
  "maxOverloads": 2,
  "forgeRestriction": null
}

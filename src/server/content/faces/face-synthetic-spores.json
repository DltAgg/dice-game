{
  "$schema": "../schema/face.schema.json",
  "id": "face-synthetic-spores",
  "name": "Spores",
  "kind": "synthetic",
  "symbol": "toxin",
  "rulesText": "On roll: if an enemy creature already has Toxin, [Mark 1 Toxin].\nOn absorb, once per turn: [Heal 1] on an allied creature that has Toxin.",
  "onRoll": [
    {
      "type": "conditional",
      "when": {
        "type": "any-enemy-has-toxin"
      },
      "then": [
        {
          "type": "apply-toxin",
          "amount": 1,
          "target": {
            "kind": "choose-enemy-with-toxin"
          }
        }
      ]
    }
  ],
  "onAbsorb": [
    {
      "type": "heal",
      "amount": 1,
      "target": {
        "kind": "choose-ally-with-toxin"
      }
    }
  ],
  "maxOverloads": 2,
  "forgeRestriction": null
}

{
  "$schema": "../schema/face.schema.json",
  "id": "face-synthetic-pack",
  "name": "Pack",
  "kind": "synthetic",
  "symbol": "wild",
  "rulesText": "On roll: if you control another adjacent creature, [Generate 1 Wild].\nOn absorb: [Empower 1] on another allied creature.",
  "onRoll": [
    {
      "type": "conditional",
      "when": {
        "type": "has-adjacent-ally"
      },
      "then": [
        {
          "type": "generate-symbol",
          "symbol": "wild",
          "amount": 1
        }
      ]
    }
  ],
  "onAbsorb": [
    {
      "type": "grant-next-attack-bonus",
      "amount": 1,
      "target": {
        "kind": "choose-ally-other"
      }
    }
  ],
  "maxOverloads": 2,
  "forgeRestriction": null
}
